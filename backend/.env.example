# Copy to .env (git-ignored) and fill in locally. Placeholders only. Never commit real values.
PORT=3001
# dev = local: x-user-id / x-dev-entra-upn headers and /api/dev/login. easyauth = App Service sign-in (Azure).
AUTH=dev
# memory = local, in-memory data. cosmos = Azure Cosmos DB (signs in with az login / managed identity).
STORE=memory
# rules = local responder. ai = approved AI service (section 4, not built yet).
AGENT=rules
# mock = local Teams mock. graph = Microsoft Graph (section 3, not built yet).
TEAMS=mock
# Built front end to serve from the API (as in Azure), e.g. ../stride/dist. Leave empty when using Vite.
STATIC_DIR=
# on = run the daily catch-up in-process.
SCHEDULER=off
# Signs Stride session cookies. Required with AUTH=easyauth; random per run in dev.
SESSION_SECRET=
# Admin token for the scheduled catch-up endpoint. Generate a random value locally.
ADMIN_TOKEN=change-me-locally
# Only for STORE=cosmos. From the deployment output, never from the team sheet into git.
AZURE_COSMOS_ENDPOINT=<cosmos-endpoint>
AZURE_COSMOS_DATABASE=stride
# Teams (TEAMS=graph). Set by infra/main.bicep in Azure; the bot cannot run locally without an Azure Bot.
BOT_APP_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Check-in meetings: link or graph.
MEETINGS=link
TEAM_NUMBER=NN
