# Copy to .env (git-ignored) and fill in locally. Placeholders only. Never commit real values.
PORT=3001
# memory = local, in-memory data. cosmos = Azure (section 2, not built yet).
STORE=memory
# rules = local responder. ai = approved AI service (section 4, not built yet).
AGENT=rules
# mock = local Teams mock. graph = Microsoft Graph (section 3, not built yet).
TEAMS=mock
# Admin token for the scheduled catch-up endpoint. Generate a random value locally.
ADMIN_TOKEN=change-me-locally
# Azure values come from the team sheet. Do not paste real values here.
AZURE_COSMOS_ENDPOINT=<cosmos-endpoint-from-team-sheet>
AZURE_KEY_VAULT_NAME=<kv-teamNN-suffix>
