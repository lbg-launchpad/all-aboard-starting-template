{
  "name": "stride-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend skeleton for Stride. Runs locally with in-memory storage; Azure wiring comes later.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/journey.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
