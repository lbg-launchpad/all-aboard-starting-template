# Copy to infra/.env (git-ignored) and fill in from the team sheet. Never commit the real file.
TEAM_NUMBER=NN
RESOURCE_GROUP=<resource-group-from-team-sheet>
# LOCATION and APP_SKU: leave unset to reuse what the last deployment used (uksouth and B1 on a first deploy).
# LOCATION=uksouth
# App Service plan size: B1 (default), F1 (free), S1 or P0v3. Change it if Azure says a size has no quota.
# APP_SKU=B1
# Teams: the Stride bot and Teams channel (true/false).
ENABLE_TEAMS=true
# Check-in meetings: link (pre-filled Teams link) or graph (real meeting, needs admin consent).
MEETINGS=link
# Optional, for ./infra/seed-demo.sh. Default: teamNN-priya@ and teamNN-ben@ your sign-in domain.
# DEMO_MANAGER_UPN=
# DEMO_BUDDY_UPN=
